#!/usr/bin/env sh

# Run typecheck + fast test suite before push
# Skippable with: git push --no-verify

echo "🔍 Pre-push: running typecheck..."
npx tsc --noEmit || {
  echo ""
  echo "=========================================="
  echo "  BLOCKED: TypeScript errors found"
  echo "  Fix them or push with --no-verify"
  echo "=========================================="
  exit 1
}

echo "🧪 Pre-push: running tests (ABI-safe)..."
# NOTE: no `| tail` here — pipelines swallow the exit code and used to let
# failing tests pass this gate. The wrapper switches better-sqlite3 to the
# Node ABI when needed and restores the Electron ABI afterwards.
node scripts/ensure-native-abi.js run --reporter=dot || {
  echo ""
  echo "=========================================="
  echo "  BLOCKED: Tests failed"
  echo "  Fix them or push with --no-verify"
  echo "=========================================="
  exit 1
}

echo "✅ Pre-push checks passed"
