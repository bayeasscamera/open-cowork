#!/usr/bin/env sh

# Run typecheck + lint + tests before push
# Skippable with: git push --no-verify

echo "🔍 Pre-push: running checks (typecheck + lint + tests)..."
# NOTE: no `| tail` here — pipelines swallow the exit code and used to let
# failing tests pass this gate. Tests go through the ABI-safe wrapper
# (better-sqlite3 Node ABI, Electron ABI restored afterwards).
npm run check || {
  echo ""
  echo "=========================================="
  echo "  BLOCKED: npm run check failed"
  echo "  Fix or push with --no-verify"
  echo "=========================================="
  exit 1
}

echo "✅ Pre-push checks passed"
